{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "..",
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "@types/*": ["types/*"],
      "@domain/*": ["domain/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
