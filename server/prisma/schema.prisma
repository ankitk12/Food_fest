// Prisma schema for the ByteBites server.
//
// The server's mutable runtime state is persisted across these relational
// tables (instead of a single JSON blob). The in-memory Store still produces a
// full snapshot on each mutation; the Prisma persistence adapter maps that
// snapshot to/from these tables.
//
// Set DATABASE_URL to your Prisma Postgres (or any Postgres) connection string.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A registered customer, keyed by their normalized mobile number.
model Customer {
  mobile String  @id
  email  String?
  name   String
}

/// A customer's FoodCoins wallet balance.
model Wallet {
  customerId String @id
  foodCoins  Int
}

/// A customer's referral record (their link + who they've already credited).
model Referral {
  customerId          String   @id
  link                String
  creditedReferredIds String[]
}

/// A placed order. Line items are stored as JSON (small, order-local data).
model Order {
  token         String  @id
  stallId       String
  items         Json
  total         Float
  status        String
  paid          Boolean
  paymentMethod String
  gatewayRef    String?
  customerId    String
  createdAt     String
  pointsUsed    Int?
  discount      Float?
  couponCode    String?
  deliveryType  String?
  deskLocation  String?
  floorNo       String?
  pickupTime    String?
}

/// A discount coupon created by the admin (e.g. SAVE10 with 10% off on orders above 200).
model Coupon {
  code            String  @id
  discountPercent Float
  minOrderValue   Float
  active          Boolean @default(true)
}

/// The food catalogue. Holds both the seeded items and any items the admin
/// creates at runtime (custom items are upserted into this same table so the
/// catalogue is the single source of truth).
model FoodItem {
  id                String @id
  name              String
  imageUrl          String
  description       String
  rating            Float
  availableQuantity Int
  price             Float
  stallId           String
  cheesePrice       Float?
  jainAvailable     Boolean?
}