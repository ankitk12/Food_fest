# Server environment variables (read at runtime via process.env).
# On Vercel, set these under Project Settings → Environment Variables; they are
# read at request time, so changing them does not require rebuilding the client.

# Merchant UPI identity used to build the checkout QR / payment intent.
# Exposed to the client via GET /api/config (non-secret).
MERCHANT_VPA=invest-a-bite@upi
MERCHANT_NAME=Invest-A-Bite
